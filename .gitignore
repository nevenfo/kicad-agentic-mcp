/target/
crates/*/target/
crates/schematic-viewer/target/
*.exe
*.dll
*.so
*.dylib
*.tmp
*.bak
.konnect-transaction-*.json
.konnect-transaction-*.abandoned.json

# KiCad's per-user local project settings, written beside any project it opens.
# The live PCB suite opens the committed fixtures, so pcbnew leaves one there on
# every run: a UI state file, never evidence.
*.kicad_prl
dist/

# Benchmark output. Named result files under bench/results/ are committed
# evidence; these two kinds are regenerated on every `gate.ps1 -Bench` run and
# would otherwise churn the diff on each measurement.
bench/results/latest-*.json
bench/results/catalog.json
__pycache__/
